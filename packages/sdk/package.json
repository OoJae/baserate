{
  "name": "@baserate/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Baserate SDK: Mezo chains, address registry, ABIs, Morpho math, MUSD permits and error decoding.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./deployments/*.json": "./src/deployments/*.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "viem": "2.57.11",
    "vitest": "5.0.5",
    "zod": "3.25.76"
  }
}
