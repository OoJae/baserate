# Public build-time settings. Only BASERATE_PUBLIC_* reaches the bundle; never put secrets here.

# Reown (WalletConnect) project id. Optional: without it the app offers injected wallets only.
BASERATE_PUBLIC_WC_PROJECT_ID=

# Set to 1 to target a local anvil fork of Mezo testnet (chain id 31337) instead of Mezo testnet.
BASERATE_PUBLIC_LOCAL_FORK=

# Baserate subgraph GraphQL endpoint (Goldsky public URL, see packages/subgraph/README.md). Optional: without it,
# history (allocator moves, distributions, accounts, backstop exits) is read from logs in the browser.
BASERATE_PUBLIC_SUBGRAPH_URL=
