{
  "$description": "Baserate brand tokens, art direction Intaglio. The same values as src/brand/tokens.css, as data for the render scripts, the HyperFrames film and the deck. docs/brand/BRAND.md explains each one.",
  "name": "Baserate",
  "artDirection": "Intaglio: Baserate as a living banknote. Copperplate engraving, guilloche, microprint, serial numbers, rate sheets and the bitcoin coin. Everything is engraved: line density makes light; no glossy gradients, glow, glass or blobs.",
  "color": {
    "palette": {
      "intaglio": {
        "hex": "#0C1512",
        "name": "Intaglio",
        "role": "Ink: text on paper and the dark ground."
      },
      "note": {
        "hex": "#F2EEE3",
        "name": "Note",
        "role": "Paper: the light ground, and engraving and text on Intaglio."
      },
      "mint": {
        "hex": "#0B6E5F",
        "name": "Mint",
        "role": "Brand: the emblem's plate, primary actions, links on paper."
      },
      "guilloche": {
        "hex": "#7FB8A6",
        "name": "Guilloche",
        "role": "Engraved line work on Intaglio. Never small text."
      },
      "amber": {
        "hex": "#F0A23B",
        "name": "Satoshi Amber",
        "role": "The single accent, for BTC only. On Intaglio."
      },
      "amberInk": {
        "hex": "#A65F0F",
        "name": "Satoshi Amber, ink",
        "role": "BTC text on paper: 24 px and up (or 18.66 px semibold), or any size on the raised paper."
      },
      "seal": {
        "hex": "#B8432F",
        "name": "Seal Red",
        "role": "Liquidation only."
      }
    },
    "support": {
      "noteRaised": {
        "hex": "#F8F6EF",
        "role": "Raised paper: cards and panels on Note."
      },
      "noteSunken": {
        "hex": "#E9E4D6",
        "role": "Sunken paper: wells and inputs on Note."
      },
      "intaglioRaised": {
        "hex": "#121C18",
        "role": "Raised ink: cards and panels on Intaglio."
      },
      "intaglioSunken": {
        "hex": "#070D0B",
        "role": "Sunken ink: wells and inputs on Intaglio."
      },
      "inkMuted": {
        "hex": "#4C524D",
        "role": "Secondary text on paper (Intaglio 72 % on Note)."
      },
      "inkFaint": {
        "hex": "#636761",
        "role": "Captions on paper (Intaglio 62 % on Note)."
      },
      "paperMuted": {
        "hex": "#ADADA4",
        "role": "Secondary text on Intaglio (Note 70 % on Intaglio)."
      },
      "paperFaint": {
        "hex": "#8B8C85",
        "role": "Captions on Intaglio (Note 55 % on Intaglio)."
      },
      "ruleOnNote": {
        "hex": "#CDCBC2",
        "role": "Engraved hairline on paper (decorative)."
      },
      "ruleOnIntaglio": {
        "hex": "#293E37",
        "role": "Engraved hairline on Intaglio (decorative; Guilloche 25 %)."
      },
      "ruleStrong": {
        "hex": "#7F827B",
        "role": "Control borders on either ground (3:1 or better)."
      },
      "amberInkStrong": {
        "hex": "#95560E",
        "role": "BTC text below 24 px directly on Note (5.0:1); Satoshi Amber ink darkened 10 %."
      },
      "sealOnIntaglio": {
        "hex": "#C46553",
        "role": "Liquidation text on Intaglio (4.7:1); Seal Red with 20 % Note."
      }
    },
    "roles": {
      "note": {
        "ground": "#F2EEE3",
        "groundRaised": "#F8F6EF",
        "groundSunken": "#E9E4D6",
        "fg": "#0C1512",
        "fgMuted": "#4C524D",
        "fgFaint": "#636761",
        "fgBrand": "#0B6E5F",
        "fgBtc": "#95560E",
        "fgSeal": "#B8432F",
        "rule": "#CDCBC2",
        "ruleStrong": "#7F827B",
        "engrave": "#0B6E5F",
        "focusRing": "#0B6E5F",
        "emblemLine": "#0B6E5F",
        "emblemPlate": "#0B6E5F",
        "emblemCut": "#F2EEE3",
        "emblemWord": "#0C1512",
        "onMint": "#F2EEE3",
        "grain": "paper fibre, 3.5 %"
      },
      "intaglio": {
        "ground": "#0C1512",
        "groundRaised": "#121C18",
        "groundSunken": "#070D0B",
        "fg": "#F2EEE3",
        "fgMuted": "#ADADA4",
        "fgFaint": "#8B8C85",
        "fgBrand": "#F2EEE3",
        "fgBtc": "#F0A23B",
        "fgSeal": "#C46553",
        "rule": "#293E37",
        "ruleStrong": "#7F827B",
        "engrave": "#7FB8A6",
        "focusRing": "#7FB8A6",
        "emblemLine": "#7FB8A6",
        "emblemPlate": "#0B6E5F",
        "emblemCut": "#F2EEE3",
        "emblemWord": "#F2EEE3",
        "onMint": "#F2EEE3",
        "grain": "none"
      }
    }
  },
  "type": {
    "families": {
      "display": {
        "family": "Bodoni Moda Variable",
        "package": "@fontsource-variable/bodoni-moda@5.3.0",
        "files": [
          "files/bodoni-moda-latin-opsz-normal.woff2",
          "files/bodoni-moda-latin-opsz-italic.woff2"
        ],
        "axes": {
          "wght": [400, 900],
          "opsz": [6, 96]
        },
        "use": "Headlines and big numerals only. Optical size follows the font size (opsz 96 at hero size); italic for one emphasised phrase.",
        "stack": "\"Bodoni Moda Variable\", \"Bodoni Moda Fallback\", Didot, \"Bodoni 72\", Georgia, serif"
      },
      "body": {
        "family": "Public Sans Variable",
        "package": "@fontsource-variable/public-sans@5.3.0",
        "files": [
          "files/public-sans-latin-wght-normal.woff2",
          "files/public-sans-latin-wght-italic.woff2"
        ],
        "axes": {
          "wght": [100, 900]
        },
        "use": "Body and UI. Tabular figures for every number.",
        "stack": "\"Public Sans Variable\", \"Public Sans Fallback\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif"
      },
      "mono": {
        "family": "IBM Plex Mono",
        "package": "@fontsource/ibm-plex-mono@5.3.0",
        "files": [
          "files/ibm-plex-mono-latin-400-normal.woff2",
          "files/ibm-plex-mono-latin-500-normal.woff2"
        ],
        "weights": [400, 500],
        "use": "Serial-number strips: addresses, block numbers, tx hashes, rates.",
        "stack": "\"IBM Plex Mono\", ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, monospace"
      }
    },
    "scale": {
      "hero": {
        "size": "clamp(3rem, 8.5vw, 9.5rem)",
        "px": {
          "390": 48,
          "1440": 122.4,
          "1920": 152
        },
        "lineHeight": 0.92,
        "tracking": "-0.025em",
        "face": "display",
        "opsz": 96
      },
      "section": {
        "size": "clamp(2.25rem, 4.6vw, 4.75rem)",
        "px": {
          "390": 36,
          "1440": 66.24,
          "1920": 76
        },
        "lineHeight": 1,
        "tracking": "-0.02em",
        "face": "display"
      },
      "lead": {
        "size": "clamp(1.125rem, 1.4vw, 1.5rem)",
        "px": {
          "390": 18,
          "1440": 20.16,
          "1920": 24
        },
        "lineHeight": 1.45,
        "tracking": "0",
        "face": "body"
      },
      "body": {
        "size": "clamp(1rem, 1.05vw, 1.125rem)",
        "px": {
          "390": 16,
          "1440": 16,
          "1920": 18
        },
        "lineHeight": 1.6,
        "tracking": "0",
        "face": "body"
      },
      "serial": {
        "size": "0.75rem",
        "px": {
          "390": 12,
          "1440": 12,
          "1920": 12
        },
        "lineHeight": 1.2,
        "tracking": "0.12em",
        "case": "uppercase",
        "hexCase": "none",
        "weight": 500,
        "face": "mono",
        "caseNote": "Labels and units are uppercase; hex values (addresses, tx hashes) keep lowercase 0x and their EIP-55 checksum case."
      }
    },
    "figures": "tabular-nums lining-nums"
  },
  "motion": {
    "ease": {
      "out": {
        "css": "cubic-bezier(0.16, 1, 0.3, 1)",
        "bezier": [0.16, 1, 0.3, 1],
        "gsap": "expo.out",
        "use": "Everything that arrives: reveals, the line wipe, the press ring."
      },
      "inOut": {
        "css": "cubic-bezier(0.65, 0, 0.35, 1)",
        "bezier": [0.65, 0, 0.35, 1],
        "gsap": "power2.inOut",
        "use": "Things that move between two states: scroll scenes, the coin's turn."
      }
    },
    "duration": {
      "micro": {
        "default": 0.3,
        "range": [0.2, 0.4],
        "use": "Hover, press, toggles."
      },
      "reveal": {
        "default": 0.8,
        "range": [0.6, 1],
        "use": "Sections and cards arriving."
      },
      "hero": {
        "default": 1.2,
        "range": [0.9, 1.4],
        "use": "The one choreographed load."
      },
      "stagger": {
        "default": 0.08,
        "range": [0.05, 0.12],
        "use": "Between siblings."
      }
    },
    "reducedMotion": "Durations fall to 0.2 s or less and travel to zero: things fade in place, nothing moves."
  },
  "shape": {
    "corner": {
      "sharp": "0",
      "control": "3px",
      "card": "6px",
      "pill": "999px"
    },
    "hairline": {
      "width": "1px",
      "css": "1px solid var(--rule)",
      "frame": "0 0 0 1px var(--rule), 0 0 0 4px var(--ground), 0 0 0 5px var(--rule)"
    }
  },
  "grain": {
    "ground": "note only",
    "opacity": 0.035,
    "tile": 240,
    "fibres": "About 200 short curved Intaglio hairlines (6 to 20 px, 0.5 to 0.8 px wide) per tile at 3.5 %, and five Mint security fibres at 10 %. Seeded, so every render is the same (guilloche.ts fibres(), PRESETS.grain).",
    "file": "/brand/grain.svg",
    "use": "Paper fibre on light grounds; never on Intaglio. tokens.css carries the same tile as --grain."
  },
  "assets": {
    "mark": "/brand/mark.svg",
    "markReverse": "/brand/mark-reverse.svg",
    "markMonoInk": "/brand/mark-mono-ink.svg",
    "markMonoPaper": "/brand/mark-mono-paper.svg",
    "wordmark": "/brand/wordmark.svg",
    "wordmarkReverse": "/brand/wordmark-reverse.svg",
    "wordmarkSolid": "/brand/wordmark-solid.svg",
    "wordmarkSolidReverse": "/brand/wordmark-solid-reverse.svg",
    "lockupHorizontal": "/brand/lockup-horizontal.svg",
    "lockupHorizontalReverse": "/brand/lockup-horizontal-reverse.svg",
    "lockupStacked": "/brand/lockup-stacked.svg",
    "lockupStackedReverse": "/brand/lockup-stacked-reverse.svg",
    "favicon": "/brand/favicon.svg",
    "faviconPng": "/brand/favicon-32.png",
    "faviconPng16": "/brand/favicon-16.png",
    "icon": "/brand/icon.svg",
    "icon192": "/brand/icon-192.png",
    "icon512": "/brand/icon-512.png",
    "appleTouchIcon": "/brand/apple-touch-icon.png",
    "manifest": "/brand/site.webmanifest",
    "band": "/brand/band.svg",
    "bandOnNote": "/brand/band-on-note.svg",
    "grain": "/brand/grain.svg",
    "coin": "/brand/coin.svg",
    "coinPng": "/brand/coin.png",
    "coinWebp": "/brand/coin.webp",
    "og": "/brand/og.png",
    "xHeader": "/brand/x-header.png"
  }
}
